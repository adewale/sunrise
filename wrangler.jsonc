{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunrise",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "sunrise", "database_id": "<DATABASE_ID>", "migrations_dir": "migrations" }
  ],
  "queues": {
    "producers": [{ "binding": "GITHUB_QUEUE", "queue": "sunrise-github" }],
    "consumers": [{ "queue": "sunrise-github", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3, "dead_letter_queue": "sunrise-github-dlq" }]
  },
  "triggers": { "crons": ["0 2 * * *", "0 6 * * *", "0 10 * * *", "0 14 * * *", "0 18 * * *", "0 22 * * *"] },
  "vars": {
    "GITHUB_REPO_URL": "https://github.com/adewale/sunrise"
  }
}
